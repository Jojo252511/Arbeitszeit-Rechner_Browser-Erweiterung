{
  "manifest_version": 3,
  "name": "Arbeitszeit-Rechner",
  "version": "1.2.1",
  "author": "Joern Unverzagt",
  "description": "Ein persönlicher Arbeitszeit-Rechner als Browser Sidebar.",
  "permissions": [
    "storage",
    "notifications",
    "geolocation"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Arbeitszeit-Rechner öffnen"
  },
  "background": {
    "scripts": ["./dist/background.js"]
  },
  "sidebar_action": {
    "default_title": "Arbeitszeit-Rechner",
    "default_panel": "index.html",
    "default_icon": "icon48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "arbeitszeit-rechner@joern-unverzagt.de",
      "strict_min_version": "109.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "countdown.html",
        "/Print/",
        "/Print/index.html",
        "Logbook.html",
        "statistics.html",
        "info.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
